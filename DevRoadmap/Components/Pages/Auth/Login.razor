@page "/login"
@using DevRoadmap.Services
@inject UsuarioService UsuarioService
@inject NavigationManager Navigation

<PageTitle>Login - DevRoadmap</PageTitle>

<main class="auth-page">
    <section class="auth-card auth-card-login" aria-labelledby="login-title">
        <header class="auth-brand">
            <div class="auth-logo" aria-hidden="true">DR</div>
            <h1 id="login-title">DevRoadmap</h1>
            <p>GPS do aprendizado para Devs</p>
        </header>

        <div class="auth-divider"></div>

        @if (!string.IsNullOrWhiteSpace(Mensagem))
        {
            <div class="alert alert-danger" role="alert">
                @Mensagem
            </div>
        }

        <EditForm Model="Model" OnValidSubmit="HandleLogin" FormName="login">
            <DataAnnotationsValidator />

            <div class="auth-field">
                <label for="email">E-mail <span aria-hidden="true">*</span></label>
                <InputText id="email" type="email" class="form-control" placeholder="seu@email.com"
                           autocomplete="email" @bind-Value="Model!.Email" />
            </div>

            <div class="auth-field">
                <label for="senha">Senha <span aria-hidden="true">*</span></label>
                <InputText id="senha" type="password" class="form-control" placeholder="Digite sua senha"
                           autocomplete="current-password" @bind-Value="Model!.Senha" />
            </div>

            <button type="submit" class="auth-submit">Entrar</button>
        </EditForm>

        <p class="auth-switch">
            Ainda não tem uma conta? <a href="/cadastro">Criar conta</a>
        </p>
        <p class="auth-switch">
            Esqueceu sua senha? <a href="/recuperar-senha">Redefinir senha</a>
        </p>
    </section>
</main>

@code {
    [SupplyParameterFromForm(FormName = "login")]
    private LoginModel? Model { get; set; }
    private string Mensagem = string.Empty;

    protected override void OnInitialized()
    {
        Model ??= new();
    }

    private void HandleLogin()
    {
        var model = Model ?? throw new InvalidOperationException("Os dados do formulário não foram recebidos.");
        var usuario = UsuarioService.Autenticar(model.Email, model.Senha);

        if (usuario is null)
        {
            Mensagem = "E-mail ou senha inválidos.";
            return;
        }

        Mensagem = string.Empty;
        Navigation.NavigateTo("/student/dashboard");
    }

    private class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Senha { get; set; } = string.Empty;
    }
}
