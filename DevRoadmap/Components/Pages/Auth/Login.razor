@page "/login"

<PageTitle>Login - DevRoadmap</PageTitle>

<main class="auth-page">
    <section class="auth-card auth-card-login" aria-labelledby="login-title">
        <header class="auth-brand">
            <div class="auth-logo" aria-hidden="true">DR</div>
            <h1 id="login-title">DevRoadmap</h1>
            <p>GPS do aprendizado para Devs</p>
        </header>

        <div class="auth-divider"></div>

        @if (Erro == "credenciais")
        {
            <div class="alert alert-danger" role="alert">
                E-mail ou senha inválidos.
            </div>
        }

        <form method="post" action="/auth/login">
            <AntiforgeryToken />

            <div class="auth-field">
                <label for="email">E-mail <span aria-hidden="true">*</span></label>
                <input id="email" name="Email" type="email" class="form-control" placeholder="seu@email.com"
                       autocomplete="email" required />
            </div>

            <div class="auth-field">
                <label for="senha">Senha <span aria-hidden="true">*</span></label>
                <input id="senha" name="Senha" type="password" class="form-control" placeholder="Digite sua senha"
                       autocomplete="current-password" required />
            </div>

            <button type="submit" class="auth-submit">Entrar</button>
        </form>

        <p class="auth-switch">
            Ainda não tem uma conta? <a href="/cadastro">Criar conta</a>
        </p>
        <p class="auth-switch">
            Esqueceu sua senha? <a href="/recuperar-senha">Redefinir senha</a>
        </p>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "erro")]
    private string? Erro { get; set; }
}
