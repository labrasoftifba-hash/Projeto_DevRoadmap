@page "/"
@layout DevRoadmap.Components.Layout.Home.HomeLayout

<PageTitle>DevRoadmap</PageTitle>

<section class="hero-section">
    <small class="small small-container">Trilhas Completas para Iniciantes</small>
    <h1 class="hero-title">Encontre o caminho certo com o GPS do Aprendizado</h1>
    <p class="hero-description">
        O DevRoadmap guia sua jornada de aprendizado por meio de trilhas organizadas, módulos 
        progressivos e desafios práticos. Aprenda no seu ritmo, acompanhe sua evolução e saiba sempre 
        qual é o próximo passo.
    </p>
    
    <div class="hero-row hero-features">
        <div class="feature-item">
            <i class="ti ti-books icon"/>
            <small class="small">Diversas trilhas disponíveis</small>
        </div>
        <div class="feature-item">
            <i class="ti ti-route icon"/>
            <small class="small">Módulos organizados</small>
        </div>
        <div class="feature-item">
            <i class="ti ti-target-arrow icon"/>
            <small class="small">Do básico ao projeto final</small>
        </div>
    </div>

    <div class="hero-row hero-actions">
        <a href="/student/dashboard" class="button button-gold">
            Começar agora
            <i class="ti ti-arrow-big-right-lines icon-button"/>
        </a>
        <a href="/student/dashboard" class="button button-outline button-solid">
            Já tenho uma conta
        </a>
    </div>
</section>