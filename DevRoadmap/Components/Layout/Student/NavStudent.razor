<nav class="sidebar">
    <div class="sidebar-logo">
        <div class="sidebar-mark">DR</div>

        <div>
            <div class="sidebar-name">DevRoadmap</div>
            <div class="sidebar-sub">GPS DO APRENDIZADO</div>
        </div>
    </div>

    <div class="sidebar-nav">
        <NavLink class="sidebar-item" href="/student/dashboard" Match="NavLinkMatch.All">
            <i class="ti ti-layout-dashboard icon-sm"/>
            Painel
        </NavLink>

        <NavLink class="sidebar-item" href="/student/roteiro" Match="NavLinkMatch.All">
            <i class="ti ti-map-2 icon-sm"/>
            @(VisaoProfessor ? "Minhas Trilhas" : "Meu Roteiro")
        </NavLink>

        <NavLink class="sidebar-item" href="/trilhas/explorar" Match="NavLinkMatch.All">
            <i class="ti ti-route icon-sm"/>
            Explorar Trilhas
        </NavLink>

        <div class="sidebar-divider"/>

        <div class="sidebar-item">
            <i class="ti ti-checklist icon-sm"/>
            Avaliações
            <span class="sidebar-badge">3</span>
        </div>

        <div class="sidebar-item">
            <i class="ti ti-star icon-sm"/>
            Resultados
        </div>

        <div class="sidebar-item">
            <i class="ti ti-upload icon-sm"/>
            Projetos
        </div>

        <div class="sidebar-divider"/>

        <div class="sidebar-item">
            <i class="ti ti-award icon-sm"/>
            Certificados
        </div>

        <div class="sidebar-item">
            <i class="ti ti-bell icon-sm"/>
            Notificações
            <span class="sidebar-badge">4</span>
        </div>
        
        <div class="sidebar-item">
            <i class="ti ti-messages icon-sm"/>
            Mensagens
        </div>
    </div>

    <div class="sidebar-profile-switch">
        <label for="profile-view-select">Visualização de teste</label>
        <select id="profile-view-select" value="@(VisaoProfessor ? "professor" : "estudante")"
                @onchange="AlterarVisao">
            <option value="estudante">Estudante</option>
            <option value="professor">Professor</option>
        </select>
    </div>

    <div class="sidebar-footer">
        <div class="sidebar-footer-actions">
            <button class="sidebar-footer-action" type="button" title="Configurações ainda indisponíveis"
                    aria-label="Configurações ainda indisponíveis" disabled>
                <i class="ti ti-settings" aria-hidden="true"></i>
            </button>

            <form method="post" action="/auth/logout">
                <AntiforgeryToken />
                <button class="sidebar-footer-action sidebar-logout" type="submit"
                        title="Sair da conta" aria-label="Sair da conta">
                    <i class="ti ti-logout" aria-hidden="true"></i>
                </button>
            </form>
        </div>
    </div>
</nav>

@code {
    [Parameter]
    public bool VisaoProfessor { get; set; }

    [Parameter]
    public EventCallback<bool> VisaoProfessorChanged { get; set; }

    private Task AlterarVisao(ChangeEventArgs args)
    {
        return VisaoProfessorChanged.InvokeAsync(args.Value?.ToString() == "professor");
    }
}