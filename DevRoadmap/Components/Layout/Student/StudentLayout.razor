@inherits LayoutComponentBase
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider

<div class="page">
    <div>
        <NavStudent />
    </div>

    <header class="main header">
        <h1 class="header-title">Painel</h1>

        <button class="header-action">
            <i class="ti ti-bell" aria-hidden="true"></i>
            <span class="notification-dot" aria-hidden="true"></span>
        </button>
        
        <div class="header-user">
            <span class="header-user-name">@NomeUsuario</span>
            <span class="header-avatar" aria-hidden="true">@IniciaisUsuario</span>
        </div>
    </header>

    <main class="main">
        <article>
            @Body
        </article>
    </main>
</div>

@code {
    private string NomeUsuario = string.Empty;
    private string IniciaisUsuario = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var nome = authenticationState.User.Identity?.Name;

        if (string.IsNullOrWhiteSpace(nome))
        {
            throw new InvalidOperationException("A sessão autenticada não contém o nome do usuário.");
        }

        NomeUsuario = nome;
        IniciaisUsuario = ObterIniciais(nome);
    }

    private static string ObterIniciais(string nome)
    {
        var partes = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return partes.Length > 1
            ? $"{partes[0][0]}{partes[^1][0]}".ToUpperInvariant()
            : partes[0][..Math.Min(2, partes[0].Length)].ToUpperInvariant();
    }
}