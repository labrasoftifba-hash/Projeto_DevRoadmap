@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider

<CascadingValue Name="VisaoProfessor" Value="visaoProfessor">
    <div class="page">
        <div>
            <NavStudent VisaoProfessor="visaoProfessor" VisaoProfessorChanged="AlterarVisaoProfessor" />
        </div>

        <header class="main header">
            <h1 class="header-title">@tituloPagina</h1>

            <div class="notification-menu">
                <button class="header-action" type="button"
                        aria-label="@(notificacoesAbertas ? "Fechar notificações" : "Abrir notificações")"
                        aria-expanded="@notificacoesAbertas"
                        @onclick="AlternarNotificacoes">
                    <i class="ti ti-bell" aria-hidden="true"></i>
                    <span class="notification-count-badge">2</span>
                </button>

                @if (notificacoesAbertas)
                {
                    <section class="notification-popover" aria-label="Notificações recentes">
                        <header class="notification-popover-header">
                            <strong>Notificações</strong>
                            <span>2 não lidas</span>
                        </header>

                        <article class="notification-preview">
                            <i class="ti ti-clipboard-check" aria-hidden="true"></i>
                            <div>
                                <strong>Nova avaliação disponível</strong>
                                <p>O quiz “React Hooks Avançados” foi publicado.</p>
                                <small>Há 5 min</small>
                            </div>
                        </article>

                        <article class="notification-preview">
                            <i class="ti ti-circle-check" aria-hidden="true"></i>
                            <div>
                                <strong>Projeto aprovado</strong>
                                <p>Seu projeto “Portfólio Responsivo” foi aprovado.</p>
                                <small>Há 30 min</small>
                            </div>
                        </article>

                        <NavLink class="notification-view-all"
                                 href="/student/notificacoes"
                                 @onclick="FecharNotificacoes">
                            Ver todas as notificações
                            <i class="ti ti-arrow-right" aria-hidden="true"></i>
                        </NavLink>
                    </section>
                }
            </div>
            
            <div class="header-user">
                <span class="header-user-name">@nomeUsuario</span>
                <span class="header-avatar" aria-hidden="true">@iniciaisUsuario</span>
            </div>
        </header>

        <main class="main">
            <article>
                @Body
            </article>
        </main>
    </div>
</CascadingValue>

@code {
    private string nomeUsuario = string.Empty;
    private string iniciaisUsuario = string.Empty;
    private bool notificacoesAbertas;

    private bool visaoProfessor;

    private string tituloPagina
    {
        get
        {
            var rota = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');

            return rota switch
            {
                "trilhas/explorar" => "Explorar Trilhas",
                "student/roteiro" => visaoProfessor ? "Minhas Trilhas" : "Meu Roteiro",
                "student/dashboard" => "Painel",
                "student/notificacoes" => "Notificações",
                "student/avaliacoes" => "Avaliações",
                _ => "DevRoadmap"
            };
        }
    }

    private void AlternarNotificacoes()
    {
        notificacoesAbertas = !notificacoesAbertas;
    }

    private void FecharNotificacoes()
    {
        notificacoesAbertas = false;
    }

    private void AlterarVisaoProfessor(bool valor)
    {
        visaoProfessor = valor;
    }

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += aoMudarDeRota;

        var authenticationState = 
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var nome = authenticationState.User.Identity?.Name;

        if(string.IsNullOrWhiteSpace(nome))
        {
            throw new InvalidOperationException(
                "A sessão autenticada não contém o nome do usuário");
        }

        nomeUsuario = nome;
        iniciaisUsuario = ObterIniciais(nome);
    }

    private void aoMudarDeRota(
        object? sender,
        Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        notificacoesAbertas = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= aoMudarDeRota;
    }

    private static string ObterIniciais(string nome)
    {
        var partes = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return partes.Length > 1
            ? $"{partes[0][0]}{partes[^1][0]}".ToUpperInvariant()
            : partes[0][..Math.Min(2, partes[0].Length)].ToUpperInvariant();
    }
}